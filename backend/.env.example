# ---------------------------------------------------------------- الأساسيات
# انسخ هذا الملف إلى .env وعدّله. لا تضع .env في Git أبدًا.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
TIME_ZONE=Asia/Damascus
LOG_LEVEL=INFO

# ---------------------------------------------------------------- قاعدة البيانات
# التطوير المحلي: اترك السطر معلّقًا ليعمل على SQLite بلا تثبيت شيء.
# الإنتاج: PostgreSQL كما في plan2 §7.
# DATABASE_URL=postgres://souq:password@localhost:5432/souq

# ---------------------------------------------------------------- الروابط
# يُستخدم في رابط المشاركة داخل رسالة واتساب الجاهزة
PUBLIC_SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- الملفات
# MEDIA_ROOT=/var/www/souq/media
# IMAGE_MAX_UPLOAD_BYTES=12582912

# ---------------------------------------------------------------- الإشعارات
# اتركه فارغًا حتى ضبط Firebase — الإشعارات تُحفظ في قاعدة البيانات وتظهر
# داخل التطبيق، ولا ينكسر شيء بلا FCM.
FCM_SERVER_KEY=

# ---------------------------------------------------------------- التخزين المؤقت
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# ---------------------------------------------------------------- الإنتاج فقط
# SECURE_SSL_REDIRECT=True
